name: Build module ZIP

on:
  push:
    branches: [dev, main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build Module
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      # 使用官方 Action 精准安装 NDK 27.3.13750724
      - name: Setup Android SDK and NDK
        uses: android-actions/setup-android@v3
        with:
          packages: 'ndk;27.3.13750724'

      - name: Build module
        run: |
          set -euo pipefail
          
          # 1. 定义真实存在的 NDK 根目录
          export NDK_ROOT_PATH="/usr/local/lib/android/sdk/ndk/27.3.13750724"
          
          # 2. 将所有相关环境变量都指向这个确定存在的路径
          export ANDROID_NDK_HOME="$NDK_ROOT_PATH"
          export ANDROID_NDK_ROOT="$NDK_ROOT_PATH"
          export ANDROID_SDK_ROOT="/usr/local/lib/android/sdk"
          export ANDROID_HOME="$ANDROID_SDK_ROOT"
          export NDK_ROOT="$NDK_ROOT_PATH"
          
          echo "--- 环境变量确认 ---"
          echo "ANDROID_HOME=$ANDROID_HOME"
          echo "ANDROID_SDK_ROOT=$ANDROID_SDK_ROOT"
          echo "ANDROID_NDK_HOME=$ANDROID_NDK_HOME"
          echo "ANDROID_NDK_ROOT=$ANDROID_NDK_ROOT"
          
          # 3. 验证路径和版本
          if [ ! -f "$ANDROID_NDK_HOME/source.properties" ]; then
            echo "错误: source.properties 文件不存在于 $ANDROID_NDK_HOME"
            exit 1
          fi
          echo "--- 版本确认 ---"
          grep Pkg.Revision "$ANDROID_NDK_HOME/source.properties"

          # 4. 执行构建
          python tools/uid-seccomp-module/build.py --output build/output

      - name: Verify the ZIP and its checksum
        run: |
          set -euo pipefail
          dir="build/output"
          zip="$(ls "$dir"/*.zip)"
          unzip -l "$zip"
          unzip -p "$zip" module.prop
          ( cd "$dir" && sha256sum -c "$(basename "$zip").sha256" )

      - uses: actions/upload-artifact@v4
        with:
          name: cq-uid-seccomp-module
          path: |
            build/output/*.zip
            build/output/*.sha256
            build/output/artifacts.json
          if-no-files-found: error
